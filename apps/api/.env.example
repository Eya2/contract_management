NODE_ENV=development
PORT=3000
# Front-end origin allowed by CORS (Angular dev server)
CORS_ORIGIN=http://localhost:4200

# docker compose default; adjust for a local Postgres install
DATABASE_URL=postgresql://cms:cms@localhost:5432/contract_mgmt_dev

# Use long random strings: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Local file storage root (swap for S3 later via STORAGE_DRIVER)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# Mailpit (docker compose) catches all outgoing mail: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Contract Hub <no-reply@contracthub.local>"
